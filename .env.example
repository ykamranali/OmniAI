# ==============================================================================
# Omni Agent — environment configuration
# Copy this file to .env and fill in real values before running docker compose.
# ==============================================================================

# --- General -------------------------------------------------------------
ENVIRONMENT=development           # development | staging | production
LOG_LEVEL=info
APP_NAME="Omni Agent"
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=omni
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=omni_agent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://omni:change_me_postgres@postgres:5432/omni_agent
# Host-side port only (container-to-container traffic always uses 5432 above).
# Change this if 5433 is also taken on your machine.
POSTGRES_HOST_PORT=5433

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Qdrant (vector DB) -------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# --- MinIO (S3-compatible storage) --------------------------------------------
MINIO_ROOT_USER=omni_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET_FILES=omni-files
MINIO_BUCKET_IMAGES=omni-images
MINIO_BUCKET_GENERATIONS=omni-generations

# --- Auth / JWT ----------------------------------------------------------------
JWT_SECRET_KEY=change_me_super_secret_key_min_32_chars
JWT_REFRESH_SECRET_KEY=change_me_another_super_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Google OAuth (optional) --------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- AI Model Gateway (LiteLLM) ------------------------------------------------
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-omni-master-key-change-me

# Upstream provider keys (optional — only needed for the providers you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# --- Ollama (local models) -----------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LOCAL_MODEL=llama3.1

# --- CORS / security -------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost
RATE_LIMIT_PER_MINUTE=120
SANDBOX_EXEC_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=15

# --- Frontend (public, exposed to browser) ------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_APP_NAME="Omni Agent"

# --- Ports (host machine) ----------------------------------------------------
# All of these are HOST-side only — container-to-container traffic always
# uses the standard internal port regardless of what you set here. Change
# any of these if the default is already taken on your machine; only
# BACKEND_PORT requires updating NEXT_PUBLIC_API_URL/NEXT_PUBLIC_WS_URL
# above to match, since those are baked into the browser bundle.
FRONTEND_PORT=3000
BACKEND_PORT=8000
NGINX_PORT=80
NGINX_SSL_PORT=443
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
LITELLM_HOST_PORT=4000
OLLAMA_HOST_PORT=11434
