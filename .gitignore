# ==============================================================================
# Omni Agent — root .gitignore
# ==============================================================================

# --- Node / Frontend -------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/coverage/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python / Backend --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
/backend/.venv/
/backend/venv/
/backend/env/
/backend/*.egg-info/
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
/backend/htmlcov/
/backend/dist/
/backend/build/

# --- Env / secrets ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
secret.txt
client.txt

# --- Databases / local state --------------------------------------------------
*.db
*.sqlite
*.sqlite3
dev.db

# --- Docker / infra -------------------------------------------------------
docker-data/
volumes/
*.log

# --- Legacy deploy configs (no longer used — Docker-based deploys now) -----
.vercel
.netlify
vercel.json
netlify.toml
set-env.js
test-gemini.mjs

# --- Editors / OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
