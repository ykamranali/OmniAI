# ==============================================================================
# Omni Agent — root .gitignore
# ==============================================================================

# --- Node / Frontend -------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/coverage/
/.next/
/.netlify/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python / Backend --------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
/backend/.venv/
/backend/venv/
/backend/env/
/backend/*.egg-info/
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
/backend/htmlcov/
/backend/dist/
/backend/build/

# --- Env / secrets ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
secret.txt
client.txt

# --- Databases / local state --------------------------------------------------
*.db
*.sqlite
*.sqlite3
dev.db

# --- Docker / infra -------------------------------------------------------
docker-data/
volumes/
*.log

# --- Legacy root-level app (superseded by frontend/ + backend/ monorepo) ---
# These files predate the Omni Agent rebuild and could not be physically
# deleted from this sandbox (mount disallows unlink) — they're harmless on
# disk but excluded from git. Safe to delete by hand from the OS file
# explorer if you want the working directory fully clean.
.vercel
.netlify
vercel.json
netlify.toml
set-env.js
test-gemini.mjs
/package.json
/package-lock.json
/tsconfig.json
/next.config.ts
/postcss.config.mjs
/eslint.config.mjs
/next-env.d.ts

# --- Sandbox scratch (undeletable stray files get parked here) -------------
/.trash/

# --- Editors / OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
